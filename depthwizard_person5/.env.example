# Safe starting profile for a laptop without an NVIDIA GPU.
# Copy to .env. Shell environment variables take precedence.
DEPTH_DEVICE=cpu
DEPTH_MODEL=depth_anything_v2_small
MODEL_MAX_SIZE=1024
VIEWER_GRID_SIZE=512
MOCK_PIPELINE=false
PIPELINE_TIMEOUT_SECONDS=1800
CORS_ORIGINS=http://127.0.0.1:5173,http://localhost:5173
# Optional GPU profile: DEPTH_DEVICE=auto, DEPTH_MODEL=depth_anything_v2_base,
# MODEL_MAX_SIZE=3072. Requires a compatible PyTorch/driver installation.
